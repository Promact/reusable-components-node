{
  "name": "reusable-components-node",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Node.js service libraries: Email, File, and Feature Flag services (behavioral port of the .NET nuget-packages)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "jest",
    "lint": "eslint packages --ext .ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
